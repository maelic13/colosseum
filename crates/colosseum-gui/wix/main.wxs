<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX v3 installer template for Colosseum.
  Used by: cargo wix --package colosseum-gui

  To build locally:
    1. Install WiX Toolset 3.x from https://wixtoolset.org/releases/
    2. cargo install cargo-wix
    3. From the workspace root: cargo wix --package colosseum-gui

  The UpgradeCode GUID must NEVER change — it ties upgrade records together.
  The ProductCode '*' tells WiX to generate a fresh GUID for each build,
  which is required for major-version upgrades.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='Colosseum'
    UpgradeCode='7B3A1E9C-4D52-4F88-A2C1-0B5E8D6F3A72'
    Manufacturer='Miloslav Macurek'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='Installer'
      Description='Colosseum Chess Engine Testing Suite'
      Manufacturer='Miloslav Macurek'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      InstallScope='perMachine'
      SummaryCodepage='1252'/>

    <!-- Prevent downgrading; silently remove old versions on upgrade -->
    <MajorUpgrade
      Schedule='afterInstallInitialize'
      DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

    <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
    <Property Id='DiskPrompt' Value='Colosseum Installation'/>

    <!-- Directory layout: C:\Program Files\Colosseum\bin\ -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='APPLICATIONFOLDER' Name='Colosseum'>

          <!-- LICENSE file in the install root -->
          <Component Id='License' Guid='*'>
            <File Id='LicenseFile'
              Name='LICENSE'
              DiskId='1'
              Source='..\..\..\..\LICENSE'
              KeyPath='yes'/>
          </Component>

          <Directory Id='Bin' Name='bin'>
            <!-- Main executable -->
            <Component Id='binary0' Guid='*'>
              <File
                Id='exe0'
                Name='colosseum.exe'
                DiskId='1'
                Source='$(var.colosseum_gui_BinDir)\colosseum.exe'
                KeyPath='yes'/>
            </Component>

            <!-- Optional PATH entry (user can deselect) -->
            <Component Id='Path' Guid='8C2F4B1D-9E73-4A56-B8D2-1C0F5E7A3B84'>
              <Environment
                Id='PATH'
                Name='PATH'
                Value='[Bin]'
                Permanent='no'
                Part='last'
                Action='set'
                System='yes'/>
              <CreateFolder/>
              <RegistryValue
                Root='HKCU'
                Key='Software\Colosseum'
                Name='installPath'
                Type='string'
                Value='[APPLICATIONFOLDER]'
                KeyPath='yes'/>
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ApplicationProgramsFolder' Name='Colosseum'/>
      </Directory>
    </Directory>

    <DirectoryRef Id='ApplicationProgramsFolder'>
      <Component Id='ApplicationShortcut' Guid='*'>
        <Shortcut
          Id='ApplicationStartMenuShortcut'
          Name='Colosseum'
          Description='Chess Engine Testing Suite'
          Target='[Bin]\colosseum.exe'
          WorkingDirectory='APPLICATIONFOLDER'/>
        <RemoveFolder Id='CleanUpShortCut' Directory='ApplicationProgramsFolder' On='uninstall'/>
        <RegistryValue
          Root='HKCU'
          Key='Software\Colosseum'
          Name='installed'
          Type='integer'
          Value='1'
          KeyPath='yes'/>
      </Component>
    </DirectoryRef>

    <!-- Feature tree -->
    <Feature
      Id='Binaries'
      Title='Application'
      Description='Installs the Colosseum executable and the GPL license.'
      Level='1'
      ConfigurableDirectory='APPLICATIONFOLDER'
      AllowAdvertise='no'
      Display='expand'
      Absent='disallow'>

      <ComponentRef Id='License'/>
      <ComponentRef Id='binary0'/>
      <ComponentRef Id='ApplicationShortcut'/>

      <Feature
        Id='Environment'
        Title='Add to PATH'
        Description='Add [ProductName] to the system PATH so it can be run from any terminal.'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='Path'/>
      </Feature>
    </Feature>

    <!-- ARP (Add/Remove Programs) metadata -->
    <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
    <Property Id='ARPHELPLINK'     Value='https://github.com/'/>
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/'/>

    <!-- Installer UI -->
    <UI>
      <UIRef Id='WixUI_FeatureTree'/>
      <!-- Skip the "Welcome" dialog and go straight to feature selection -->
      <Publish Dialog='WelcomeDlg'  Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
      <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg'  Order='99'>1</Publish>
    </UI>

    <!-- License text shown in the installer -->
    <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>
  </Product>
</Wix>
